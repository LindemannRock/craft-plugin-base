{
  "name": "lindemannrock-base",
  "version": "1.0.0",
  "description": "Build tools for LindemannRock Plugin Base",
  "scripts": {
    "minify": "npm run minify:js && npm run minify:css",
    "minify:js": "terser src/web/assets/analytics/analytics.js -o src/web/assets/analytics/analytics.min.js -c -m",
    "minify:css": "cleancss -o src/web/assets/components/components.min.css src/web/assets/components/components.css"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "terser": "^5.31.6"
  }
}
