#!/usr/bin/env bash
#
# Pre-commit hook: runs the read-only PHPStan and ECS checks through Composer.

set -u

PACKAGE_ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$PACKAGE_ROOT/../.." 2>/dev/null && pwd -P)"

cd "$PACKAGE_ROOT" || {
    echo "Unable to enter the Base package directory." >&2
    exit 1
}

if [ "$PACKAGE_ROOT" = "$WORKSPACE_ROOT/plugins/base" ] && [ -f "$WORKSPACE_ROOT/.ddev/config.yaml" ]; then
    if ! command -v ddev >/dev/null 2>&1; then
        echo "Base is inside the workspace DDEV project, but 'ddev' is unavailable." >&2
        echo "Install/start DDEV, then rerun the commit; host PHP is not a supported workspace fallback." >&2
        exit 127
    fi

    echo "Running Base code quality checks through the workspace DDEV runtime..."
    (
        cd "$WORKSPACE_ROOT" || exit 1
        ddev exec "cd plugins/base && php -r 'fwrite(STDOUT, \"Base pre-commit using DDEV PHP \" . PHP_VERSION . PHP_EOL);' && composer ci"
    )
    status=$?
    if [ "$status" -ne 0 ]; then
        echo "Base pre-commit checks failed in DDEV (exit $status)." >&2
        echo "Run: ddev exec \"cd plugins/base && composer ci\"" >&2
        exit "$status"
    fi

    echo "Base pre-commit checks passed."
    exit 0
fi

if ! command -v php >/dev/null 2>&1; then
    echo "Standalone Base checks require PHP, but 'php' is unavailable." >&2
    exit 127
fi
if ! command -v composer >/dev/null 2>&1; then
    echo "Standalone Base checks require Composer, but 'composer' is unavailable." >&2
    exit 127
fi

echo "Validating standalone Composer platform requirements..."
composer check-platform-reqs --no-interaction
status=$?
if [ "$status" -ne 0 ]; then
    echo "Standalone Composer platform validation failed (exit $status)." >&2
    echo "Use a PHP/platform combination supported by the installed dependencies, run composer install, and retry." >&2
    exit "$status"
fi

echo "Validating standalone PHP quality-tool compatibility..."
php scripts/check-quality-platform.php
status=$?
if [ "$status" -ne 0 ]; then
    php_version="$(php -r 'echo PHP_VERSION;' 2>/dev/null)"
    echo "Standalone quality tools are incompatible with active PHP ${php_version:-unknown} (exit $status)." >&2
    echo "Use a runtime supported by the installed quality tools, or update the standalone dependencies, before retrying." >&2
    exit "$status"
fi

echo "Running standalone Base code quality checks..."
composer ci
status=$?
if [ "$status" -ne 0 ]; then
    echo "Base pre-commit checks failed (exit $status)." >&2
    echo "Run: composer ci" >&2
    exit "$status"
fi

echo "Base pre-commit checks passed."
exit 0
