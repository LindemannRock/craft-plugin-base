{#
  IP Hash Salt Error Partial

  Displays an admin error banner when analytics is enabled but IP hash salt is missing.

  Usage:
  {% include 'lindemannrock-base/_partials/ip-salt-error' with {
      translationCategory: 'redirect-manager'
  } %}

  @link      https://lindemannrock.com
  @copyright Copyright (c) 2025 LindemannRock
#}

{% set translationCategory = translationCategory ?? 'app' %}
{% set plugin = craft.app.plugins.getPlugin(translationCategory) %}
{% set pluginId = plugin and plugin.id is defined and plugin.id ? plugin.id : translationCategory %}
{% set envVarName = envVarName ?? (translationCategory|replace({'-': '_'})|upper ~ '_IP_SALT') %}

{% set analyticsEnabled = plugin and (plugin.settings.enableAnalytics ?? false) %}
{% set actualSalt = plugin ? (plugin.settings.ipHashSalt ?? null) : null %}
{% set saltIsMissing = not actualSalt or actualSalt == ('$' ~ envVarName) %}

{% if analyticsEnabled and saltIsMissing %}
    <div class="error-summary" tabindex="-1" style="margin-bottom: 24px;">
        <div>
            <span class="notification-icon" data-icon="alert" aria-label="{{ 'error'|t(translationCategory) }}" role="img"></span>
            <h2>{{ 'Configuration Required'|t(translationCategory) }}</h2>
        </div>
        <ul class="errors">
            <li>
                <strong>{{ 'IP hash salt is missing.'|t(translationCategory) }}</strong> {{ 'Analytics tracking requires a secure salt for privacy protection.'|t(translationCategory) }}
                <br><br>
                <strong>{{ 'Run one of these commands in your terminal:'|t(translationCategory) }}</strong>
                <br><br>

                <div>
                    <div style="margin-bottom: 12px;">
                        <strong style="font-size: 13px; color: #596673; display: block; margin-bottom: 4px;">{{ 'Standard:'|t(translationCategory) }}</strong>
                        <div style="position: relative; display: flex; align-items: center; gap: 8px;">
                            <code id="salt-cmd-normal" style="background: #f9fafb; padding: 10px 12px; border-radius: 4px; flex: 1; border: 1px solid #e5e7eb; font-size: 13px; font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;">php craft {{ pluginId }}/security/generate-salt</code>
                            <button type="button" onclick="copyToClipboard('salt-cmd-normal', this)" style="background: #0d78f2; color: white; border: none; padding: 10px 16px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 600; white-space: nowrap;">{{ 'COPY'|t(translationCategory) }}</button>
                        </div>
                    </div>

                    <div>
                        <strong style="font-size: 13px; color: #596673; display: block; margin-bottom: 4px;">{{ 'DDEV:'|t(translationCategory) }}</strong>
                        <div style="position: relative; display: flex; align-items: center; gap: 8px;">
                            <code id="salt-cmd-ddev" style="background: #f9fafb; padding: 10px 12px; border-radius: 4px; flex: 1; border: 1px solid #e5e7eb; font-size: 13px; font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;">ddev craft {{ pluginId }}/security/generate-salt</code>
                            <button type="button" onclick="copyToClipboard('salt-cmd-ddev', this)" style="background: #0d78f2; color: white; border: none; padding: 10px 16px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 600; white-space: nowrap;">{{ 'COPY'|t(translationCategory) }}</button>
                        </div>
                    </div>
                </div>

                <br>
                {{ 'This will automatically add'|t(translationCategory) }} <code>{{ envVarName }}</code> {{ 'to your'|t(translationCategory) }} <code>.env</code> {{ 'file.'|t(translationCategory) }}
                <br>
                <strong style="color: #d97706;">{{ 'Warning:'|t(translationCategory) }}</strong> {{ 'Copy the same salt to staging and production environments.'|t(translationCategory) }}

                <script>
                function copyToClipboard(elementId, button) {
                    const element = document.getElementById(elementId);
                    const text = element.textContent;

                    navigator.clipboard.writeText(text).then(function() {
                        const originalText = button.textContent;
                        button.textContent = {{ 'COPIED!'|t(translationCategory)|json_encode|raw }};
                        button.style.background = '#10b981';

                        setTimeout(function() {
                            button.textContent = originalText;
                            button.style.background = '#0d78f2';
                        }, 2000);
                    }).catch(function(err) {
                        console.error('Failed to copy:', err);
                        alert({{ 'Failed to copy to clipboard'|t(translationCategory)|json_encode|raw }});
                    });
                }
                </script>
            </li>
        </ul>
    </div>
{% endif %}
