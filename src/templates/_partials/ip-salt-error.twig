{#
  IP Hash Salt Error Partial @since 5.25.0

  Displays a warning info-box when a plugin's analytics is enabled but its
  IP hash salt is missing (or still holds the literal `$ENVVAR_NAME` string,
  meaning the env var was never set). Shows the appropriate console commands
  for generating one (both Standard and DDEV variants) with copy-to-clipboard
  buttons, plus the env var name that will be added to `.env`.

  Usage:
  {% include 'lindemannrock-base/_partials/ip-salt-error' with {
      pluginHandle: 'redirect-manager',
  } only %}

  Parameters:
  - pluginHandle (required, string) — plugin handle used to (a) resolve the
    plugin instance for reading its `enableAnalytics` + `ipHashSalt`
    settings, (b) build the console command path, and (c) derive the
    default env var name.
  - envVarName   (optional, string) — override the derived env var name.
    Defaults to `{pluginHandle uppercased, hyphens → underscores}_IP_SALT`
    (e.g., `redirect-manager` → `REDIRECT_MANAGER_IP_SALT`).

  Behaviour:
  - Renders nothing when analytics is disabled OR salt is set correctly.
  - All emitted UI strings route through `|t('lindemannrock-base')` —
    plugins consuming this partial do not need any matching keys in their
    own translation files.
  - Copy-to-clipboard JS is IIFE-scoped per render (unique `boxId`) so
    multiple invocations on the same page don't collide.
  - Clipboard write uses the modern `navigator.clipboard` API with a
    `document.execCommand('copy')` fallback for older browsers / non-secure
    contexts. Failed copy alerts the user.

  @link      https://lindemannrock.com
  @copyright Copyright (c) 2026 LindemannRock
#}

{# Backward-compat: accept legacy `translationCategory` param name. Drop after one release cycle. #}
{% set pluginHandle = pluginHandle ?? translationCategory ?? 'app' %}
{% set plugin = craft.app.plugins.getPlugin(pluginHandle) %}
{% set pluginId = plugin and plugin.id is defined and plugin.id ? plugin.id : pluginHandle %}
{% set envVarName = envVarName ?? (pluginHandle|replace({'-': '_'})|upper ~ '_IP_SALT') %}

{% set analyticsEnabled = plugin and (plugin.settings.enableAnalytics ?? false) %}
{% set actualSalt = plugin ? (plugin.settings.ipHashSalt ?? null) : null %}
{% set saltIsMissing = not actualSalt or actualSalt == ('$' ~ envVarName) %}

{% if analyticsEnabled and saltIsMissing %}
    {% set boxId = 'lr-ip-salt-' ~ random(999999999) %}

    {% set messageHtml %}
        <strong>{{ 'Configuration Required'|t('lindemannrock-base') }}</strong>

        <p style="margin: 0.5rem 0;">
            <strong>{{ 'IP hash salt is missing.'|t('lindemannrock-base') }}</strong>
            {{ 'Analytics tracking requires a secure salt for privacy protection.'|t('lindemannrock-base') }}
        </p>

        <p style="margin: 0.75rem 0 0.5rem;">
            <strong>{{ 'Run one of these commands in your terminal:'|t('lindemannrock-base') }}</strong>
        </p>

        <div id="{{ boxId }}">
            <div style="margin-bottom: 0.5rem;">
                <p class="light" style="margin: 0 0 0.25rem;">{{ 'Standard:'|t('lindemannrock-base') }}</p>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <input type="text"
                           readonly
                           class="text fullwidth lr-ip-salt-input"
                           value="php craft {{ pluginId }}/security/generate-salt"
                           style="font-family: ui-monospace, 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace; cursor: copy; flex: 1;">
                    <button type="button"
                            class="btn lr-ip-salt-copy-btn"
                            data-original-label="{{ 'Copy'|t('lindemannrock-base')|e('html_attr') }}"
                            data-copied-label="{{ 'Copied!'|t('lindemannrock-base')|e('html_attr') }}"
                            style="white-space: nowrap;">{{ 'Copy'|t('lindemannrock-base') }}</button>
                </div>
            </div>

            <div>
                <p class="light" style="margin: 0 0 0.25rem;">{{ 'DDEV:'|t('lindemannrock-base') }}</p>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <input type="text"
                           readonly
                           class="text fullwidth lr-ip-salt-input"
                           value="ddev craft {{ pluginId }}/security/generate-salt"
                           style="font-family: ui-monospace, 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace; cursor: copy; flex: 1;">
                    <button type="button"
                            class="btn lr-ip-salt-copy-btn"
                            data-original-label="{{ 'Copy'|t('lindemannrock-base')|e('html_attr') }}"
                            data-copied-label="{{ 'Copied!'|t('lindemannrock-base')|e('html_attr') }}"
                            style="white-space: nowrap;">{{ 'Copy'|t('lindemannrock-base') }}</button>
                </div>
            </div>
        </div>

        <p style="margin: 0.75rem 0 0.25rem;">
            {{ 'This will automatically add {envVar} to your .env file.'|t('lindemannrock-base', {envVar: '<code>' ~ envVarName ~ '</code>'})|raw }}
        </p>

        <p style="margin: 0;">
            <strong>{{ 'Warning:'|t('lindemannrock-base') }}</strong>
            {{ 'Copy the same salt to staging and production environments.'|t('lindemannrock-base') }}
        </p>
    {% endset %}

    {% include 'lindemannrock-base/_components/info-box' with {
        message: messageHtml,
        type: 'warning',
        variant: 'colored',
        margin: 'bottom',
        allowHtml: true,
    } only %}

    <script>
    (function() {
        var box = document.getElementById({{ boxId|json_encode|raw }});
        if (!box) return;

        var inputs = box.querySelectorAll('.lr-ip-salt-input');
        var buttons = box.querySelectorAll('.lr-ip-salt-copy-btn');

        function showCopiedFeedback(button) {
            var copiedLabel = button.dataset.copiedLabel;
            var originalLabel = button.dataset.originalLabel;
            button.textContent = copiedLabel;
            button.classList.add('secondary');
            setTimeout(function() {
                button.textContent = originalLabel;
                button.classList.remove('secondary');
            }, 2000);
        }

        function fallbackCopy(input, button) {
            input.select();
            try {
                document.execCommand('copy');
                showCopiedFeedback(button);
            } catch (_) {
                alert({{ 'Failed to copy to clipboard'|t('lindemannrock-base')|json_encode|raw }});
            }
        }

        inputs.forEach(function(input) {
            input.addEventListener('click', function() {
                this.select();
            });
        });

        buttons.forEach(function(button, index) {
            button.addEventListener('click', function() {
                var input = inputs[index];
                if (!input) return;
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(input.value).then(function() {
                        showCopiedFeedback(button);
                    }).catch(function() { fallbackCopy(input, button); });
                } else {
                    fallbackCopy(input, button);
                }
            });
        });
    })();
    </script>
{% endif %}
