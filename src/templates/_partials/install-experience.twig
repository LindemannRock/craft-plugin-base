{% set experience = experience ?? {} %}
{% set accent = experience.accent ?? '#0f766e' %}
{% set sidebarColor = experience.sidebarColor ?? experience.iconColor ?? accent %}
{% set uiColor = experience.uiColor ?? sidebarColor %}
{% set theme = experience.theme ?? 'classic' %}

<div
    id="lr-install-experience"
    class="lr-install-experience"
    aria-hidden="true"
    style="--lr-install-accent: {{ accent }}; --lr-install-sidebar: {{ sidebarColor }}; --lr-install-ui: {{ uiColor }};"
>
    <div class="lr-install-experience__backdrop" data-lr-install-close></div>
    <div class="lr-install-experience__canvas-wrap" aria-hidden="true">
        <canvas class="lr-install-experience__canvas"></canvas>
    </div>
    <section class="lr-install-experience__dialog" role="dialog" aria-modal="true" aria-labelledby="lr-install-experience-title">
        <button type="button" class="lr-install-experience__close" aria-label="{{ 'Close dialog'|t('lindemannrock-base') }}" data-lr-install-close>
            <span aria-hidden="true">&times;</span>
        </button>
        <div class="lr-install-experience__glow"></div>
        <div class="lr-install-experience__shapes" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <div class="lr-install-experience__hero" aria-hidden="true">
            <div class="lr-install-experience__hero-body">
                <div class="lr-install-experience__hero-art">
                    <div class="lr-install-experience__hero-bgmark" aria-hidden="true">
                        <svg viewBox="0 -334.195 1350.04 1350.04" xmlns="http://www.w3.org/2000/svg">
                            <g fill="#E52521">
                                {{ experience.logoPaths|raw }}
                            </g>
                        </svg>
                    </div>
                    {% if experience.iconSvg ?? null %}
                        <div class="lr-install-experience__hero-icon">
                            {{ experience.iconSvg|raw }}
                        </div>
                    {% else %}
                        <div class="lr-install-experience__hero-fallback-mark" aria-hidden="true">
                            <svg viewBox="0 -334.195 1350.04 1350.04" xmlns="http://www.w3.org/2000/svg">
                                <g fill="#E52521">
                                    {{ experience.logoPaths|raw }}
                                </g>
                            </svg>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="lr-install-experience__content">
            <p class="lr-install-experience__eyebrow">{{ experience.eyebrow ?? ('Installed successfully'|t('lindemannrock-base')) }}</p>
            <h2 id="lr-install-experience-title">{{ experience.headline ?? ('Plugin installed'|t('lindemannrock-base')) }}</h2>
            {% if experience.pluginVersion ?? null %}
                <p class="lr-install-experience__version">{{ 'Version'|t('lindemannrock-base') }} {{ experience.pluginVersion }}</p>
            {% endif %}
            <p class="lr-install-experience__body">{{ experience.body ?? '' }}</p>
            <div class="lr-install-experience__actions">
                <a class="btn submit" href="{{ cpUrl(experience.ctaUrl ?? experience.redirectUri ?? '') }}">
                    {{ experience.ctaLabel ?? ('Continue'|t('lindemannrock-base')) }}
                </a>
            </div>
            <div class="lr-install-experience__brand-panel">
                <a class="lr-install-experience__brand-credit" href="https://lindemannrock.com" target="_blank" rel="noopener">
                    <span class="lr-install-experience__brand-pill">
                        <span class="lr-install-experience__brand-logo" aria-hidden="true">
                            <svg viewBox="0 -.186 1350.04 682.02" xmlns="http://www.w3.org/2000/svg">
                                <g>
                                    {{ experience.logoPaths|raw }}
                                </g>
                            </svg>
                        </span>
                    </span>
                </a>
            </div>
        </div>
    </section>
</div>
