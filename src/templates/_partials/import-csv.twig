{#
 # CSV Import Partial
 #
 # Reusable CSV import form block for CP pages.
 #
 # Parameters:
 # - action: Form action URL (required)
 # - formId: Form ID (optional)
 # - title: Section title
 # - description: Intro text
 # - csvFormatTip: HTML string for the info popover (optional)
 # - csvDescription: Description shown inside CSV section when using mode switch
 # - secondaryDescription: Description shown inside alternate section
 # - fileLabel: File field label
 # - fileInstructions: File field instructions
 # - delimiterLabel: Delimiter label
 # - delimiterInstructions: Delimiter instructions
 # - delimiterValue: Selected delimiter value (default: 'auto')
 # - delimiterOptions: Options array for delimiter select
 # - showBackupToggle: Whether to show backup toggle
 # - backupLabel: Backup label
 # - backupInstructions: Backup instructions
 # - backupEnabled: Backup master switch (bool)
 # - backupOnImport: Backup-on-import default (bool)
 # - backupWarning: Warning string when backups disabled
 # - submitLabel: Submit button label
 # - showModeSwitch: Whether to show a mode switch (CSV vs alternate import)
 # - primaryLabel: Label for the CSV mode button
 # - secondaryLabel: Label for the alternate import mode button
 # - secondaryHtml: HTML content for the alternate import mode
 # - modeDefault: Default mode ('csv' or 'secondary')
 # - renderTitleInSection: Move title/instructions inside CSV section when using mode switch
 #}

{% import "_includes/forms" as forms %}

{% set action = action ?? '' %}
{% set formId = formId ?? '' %}
{% set wrapForm = wrapForm ?? true %}
{% set includeCsrf = includeCsrf ?? wrapForm %}
{% set title = title ?? 'Import from CSV'|t('lindemannrock-base') %}
{% set description = description ?? '' %}
{% set csvFormatTip = csvFormatTip ?? null %}
{% set csvDescription = csvDescription ?? null %}
{% set secondaryDescription = secondaryDescription ?? null %}
{% set fileLabel = fileLabel ?? 'CSV File'|t('lindemannrock-base') %}
{% set fileInstructions = fileInstructions ?? '' %}
{% set fileId = fileId ?? 'csvFile' %}
{% set fileName = fileName ?? 'csvFile' %}
{% set delimiterLabel = delimiterLabel ?? 'CSV Delimiter'|t('lindemannrock-base') %}
{% set delimiterInstructions = delimiterInstructions ?? '' %}
{% set delimiterValue = delimiterValue ?? 'auto' %}
{% set delimiterOptions = delimiterOptions ?? {
    'auto': 'Auto (detect)'|t('lindemannrock-base'),
    ',': 'Comma (,)'|t('lindemannrock-base'),
    ';': 'Semicolon (;)'|t('lindemannrock-base'),
    "\t": 'Tab'|t('lindemannrock-base'),
    '|': 'Pipe (|)'|t('lindemannrock-base'),
} %}
{% set showBackupToggle = showBackupToggle ?? false %}
{% set backupLabel = backupLabel ?? 'Create Backup Before Import'|t('lindemannrock-base') %}
{% set backupInstructions = backupInstructions ?? '' %}
{% set backupEnabled = backupEnabled ?? true %}
{% set backupOnImport = backupOnImport ?? true %}
{% set backupWarning = backupWarning ?? null %}
{% set submitLabel = submitLabel ?? 'Upload & Map Columns'|t('lindemannrock-base') %}
{% set infoBoxMessage = infoBoxMessage ?? null %}
{% set showModeSwitch = showModeSwitch ?? false %}
{% set primaryLabel = primaryLabel ?? 'CSV Import'|t('lindemannrock-base') %}
{% set secondaryLabel = secondaryLabel ?? 'Alternate Import'|t('lindemannrock-base') %}
{% set secondaryHtml = secondaryHtml ?? null %}
{% set modeDefault = modeDefault ?? 'csv' %}
{% set toggleId = toggleId ?? (formId ? formId ~ '-mode-switch' : 'csv-import-mode-switch') %}
{% set renderTitleInSection = renderTitleInSection ?? false %}

{% if not (showModeSwitch and secondaryHtml and renderTitleInSection) %}
    <div class="field">
        <div class="heading">
            <label>{{ title }}</label>
            {% if csvFormatTip %}
                <span class="info">{{ csvFormatTip|raw }}</span>
            {% endif %}
            {% if description and not (showModeSwitch and secondaryHtml) %}
                <div class="instructions">
                    <p>{{ description }}</p>
                </div>
            {% endif %}
        </div>
    </div>
{% endif %}

{% if showModeSwitch and secondaryHtml %}
    <div class="btngroup" id="{{ toggleId }}" style="margin-bottom: 24px;">
        <button type="button" class="btn {{ modeDefault == 'csv' ? 'active' : '' }}" data-import-mode="csv" aria-pressed="{{ modeDefault == 'csv' ? 'true' : 'false' }}">
            {{ primaryLabel }}
        </button>
        <button type="button" class="btn {{ modeDefault == 'secondary' ? 'active' : '' }}" data-import-mode="secondary" aria-pressed="{{ modeDefault == 'secondary' ? 'true' : 'false' }}">
            {{ secondaryLabel }}
        </button>
    </div>
{% endif %}

<div id="{{ toggleId }}-csv" class="{{ showModeSwitch and secondaryHtml and modeDefault != 'csv' ? 'hidden' : '' }}">
    {% if showModeSwitch and secondaryHtml and renderTitleInSection %}
        <div class="field">
            <div class="heading">
                <label>{{ title }}</label>
                {% if csvFormatTip %}
                    <span class="info">{{ csvFormatTip|raw }}</span>
                {% endif %}
                {% if csvDescription or description %}
                    <div class="instructions">
                        <p>{{ csvDescription ?? description }}</p>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
    {% if showModeSwitch and secondaryHtml and (csvDescription or description) and not renderTitleInSection %}
        <div class="instructions" style="margin-bottom: 12px;">
            <p>{{ csvDescription ?? description }}</p>
        </div>
    {% endif %}
{% if wrapForm %}
<form method="post" action="{{ action }}" enctype="multipart/form-data" {% if formId %}id="{{ formId }}"{% endif %}>
    {% if includeCsrf %}{{ csrfInput() }}{% endif %}
{% endif %}

    {{ forms.fileField({
        label: fileLabel,
        instructions: fileInstructions,
        id: fileId,
        name: fileName,
        required: true,
    }) }}

    {{ forms.selectField({
        label: delimiterLabel,
        instructions: delimiterInstructions,
        id: 'delimiter',
        name: 'delimiter',
        value: delimiterValue,
        options: delimiterOptions,
        required: true,
    }) }}

    {% if showBackupToggle %}
        {{ forms.lightswitchField({
            label: backupLabel,
            instructions: backupInstructions,
            id: 'createBackup',
            name: 'createBackup',
            on: backupEnabled and backupOnImport,
            disabled: not backupEnabled,
            warning: not backupEnabled ? backupWarning : null,
        }) }}
    {% endif %}

    {% if infoBoxMessage %}
        {% include 'lindemannrock-base/_components/info-box' with {
            message: infoBoxMessage,
        } %}
    {% endif %}

    <div class="buttons">
        <button type="submit" class="btn submit">{{ submitLabel }}</button>
    </div>
{% if wrapForm %}
</form>
{% endif %}
</div>

{% if showModeSwitch and secondaryHtml %}
    <div id="{{ toggleId }}-secondary" class="{{ modeDefault == 'secondary' ? '' : 'hidden' }}">
        {% if secondaryDescription %}
            <div class="instructions" style="margin-bottom: 12px;">
                <p>{{ secondaryDescription }}</p>
            </div>
        {% endif %}
        {{ secondaryHtml|raw }}
    </div>
{% endif %}

{% if showModeSwitch and secondaryHtml %}
{% js %}
    (function() {
        const switcher = document.getElementById('{{ toggleId }}');
        if (!switcher) {
            return;
        }

        const csvSection = document.getElementById('{{ toggleId }}-csv');
        const secondarySection = document.getElementById('{{ toggleId }}-secondary');

        switcher.addEventListener('click', function(e) {
            const button = e.target.closest('button[data-import-mode]');
            if (!button) {
                return;
            }

            const mode = button.getAttribute('data-import-mode');
            const buttons = switcher.querySelectorAll('button[data-import-mode]');
            buttons.forEach(btn => {
                const isActive = btn === button;
                btn.classList.toggle('active', isActive);
                btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            });

            if (mode === 'secondary') {
                csvSection?.classList.add('hidden');
                secondarySection?.classList.remove('hidden');
            } else {
                secondarySection?.classList.add('hidden');
                csvSection?.classList.remove('hidden');
            }
        });
    })();
{% endjs %}
{% endif %}
