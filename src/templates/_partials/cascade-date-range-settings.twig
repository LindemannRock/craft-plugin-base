{#
/**
 * Date Range Settings
 *
 * Renders a single CP form field for a plugin's `defaultDateRange` setting
 * with a "Use global default" option that lets the value cascade from base
 * config / hardcoded default via `DateRangeHelper::getDefaultDateRange()`.
 *
 * Include this partial in plugin settings pages whose Settings model uses
 * `lindemannrock\base\traits\DateRangeSettingsTrait`.
 *
 * Most plugins should include the umbrella `_partials/cascade-base-overrides` partial
 * with `sections.dateRange` instead of this one directly — the umbrella adds
 * the shared "Base Settings Overrides" heading + cascade info-box once.
 *
 * Required variables:
 * - settings: Plugin Settings model using DateRangeSettingsTrait
 * - pluginHandle: Plugin handle used in config-override warning messages
 *
 * Usage (standalone — without the umbrella):
 * {% include 'lindemannrock-base/_partials/cascade-date-range-settings' with {
 *     settings: settings,
 *     pluginHandle: 'search-manager',
 * } only %}
 */
#}

{% import "_includes/forms" as forms %}
{% set inheritLabel = 'Use global default'|t('lindemannrock-base') %}
{% set isOverridden = settings.isOverriddenByConfig('defaultDateRange') %}
{# When overridden by config, display the cascade-resolved (effective) value
   so the form reflects what's actually in force — not the stale DB value. #}
{% set effectiveValue = isOverridden ? lrDefaultDateRange(pluginHandle) : settings.defaultDateRange %}

{{ forms.selectField({
    label: 'Default Date Range'|t('lindemannrock-base'),
    instructions: 'Default time window applied to analytics, logs, and dashboard pages in this plugin.'|t('lindemannrock-base'),
    id: 'defaultDateRange',
    name: 'settings[defaultDateRange]',
    value: effectiveValue,
    options: [
        {label: inheritLabel, value: ''},
        {label: 'Today'|t('lindemannrock-base'), value: 'today'},
        {label: 'Yesterday'|t('lindemannrock-base'), value: 'yesterday'},
        {label: 'This week'|t('lindemannrock-base'), value: 'thisWeek'},
        {label: 'Last week'|t('lindemannrock-base'), value: 'lastWeek'},
        {label: 'Last 7 days'|t('lindemannrock-base'), value: 'last7days'},
        {label: 'Last 14 days'|t('lindemannrock-base'), value: 'last14days'},
        {label: 'Last 30 days'|t('lindemannrock-base'), value: 'last30days'},
        {label: 'Last 90 days'|t('lindemannrock-base'), value: 'last90days'},
        {label: 'This month'|t('lindemannrock-base'), value: 'thisMonth'},
        {label: 'Last month'|t('lindemannrock-base'), value: 'lastMonth'},
        {label: 'This quarter'|t('lindemannrock-base'), value: 'thisQuarter'},
        {label: 'Last quarter'|t('lindemannrock-base'), value: 'lastQuarter'},
        {label: 'This year'|t('lindemannrock-base'), value: 'thisYear'},
        {label: 'Last year'|t('lindemannrock-base'), value: 'lastYear'},
        {label: 'Last 12 months'|t('lindemannrock-base'), value: 'last12months'},
        {label: 'All time'|t('lindemannrock-base'), value: 'all'},
    ],
    disabled: isOverridden,
    warning: isOverridden ?
        'This is being overridden by the <code>{setting}</code> setting in <code>config/{handle}.php</code>.'|t('lindemannrock-base', {setting: 'defaultDateRange', handle: pluginHandle})|raw : null,
    errors: settings.getErrors('defaultDateRange'),
}) }}
