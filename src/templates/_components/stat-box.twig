{#
 # Stat Box Component
 #
 # Displays a single statistic with value and label.
 # Used in analytics dashboards for key metrics.
 #
 # Parameters:
 #   - value: The numeric or text value to display
 #   - label: Description label for the stat
 #   - id: (optional) HTML id for dynamic updates
 #   - color: (optional) Custom color for value only (default: #0d78f2)
 #   - palette: (optional) Palette color name for full colored box (e.g., 'green', 'red', 'amber')
 #              Derives background, border, and value color from the palette color
 #   - suffix: (optional) Suffix to append (e.g., '%', 'ms')
 #   - prefix: (optional) Prefix to prepend (e.g., '$')
 #   - size: (optional) 'small' for compact version
 #   - class: (optional) Additional CSS classes
 #   - valueIsFormatted: (optional) true when value should render as provided
 #
 # Examples:
 #   // Basic (default blue value)
 #   {% include 'lindemannrock-base/_components/stat-box' with {
 #       value: 1234,
 #       label: 'Total Messages',
 #   } only %}
 #
 #   // With palette color (full colored box)
 #   {% include 'lindemannrock-base/_components/stat-box' with {
 #       value: 50,
 #       label: 'New Items',
 #       palette: 'green',
 #   } only %}
 #
 # Grid usage (use .compact for 5 columns):
 #   <div class="lr-analytics-stats compact">
 #       {% include '...' with {value: 100, label: 'Total'} %}
 #       {% include '...' with {value: 50, label: 'New', palette: 'green'} %}
 #   </div>
 #}

{% set valueId = id ?? '' %}
{% set valueSuffix = suffix ?? '' %}
{% set valuePrefix = prefix ?? '' %}
{% set isSmall = (size ?? '') == 'small' %}
{% set paletteName = palette ?? null %}
{% set extraClass = class ?? '' %}
{% set isValueFormatted = valueIsFormatted ?? false %}
{% set hasCustomColor = color is defined and color %}

{# Get palette color data if specified #}
{% if paletteName %}
    {% set paletteColor = lrPaletteColor(paletteName) %}
    {% set valueColor = paletteColor.color ?? '#0d78f2' %}
    {% set rgbValue = paletteColor.rgb ?? '13, 120, 242' %}
    {% set boxStyle = 'background: rgba(' ~ rgbValue ~ ', 0.12); border-color: rgba(' ~ rgbValue ~ ', 0.35);' %}
{% else %}
    {% set valueColor = hasCustomColor ? color : null %}
    {% set boxStyle = '' %}
{% endif %}
{% set valueStyle = valueColor ? 'color: ' ~ valueColor ~ ';' : '' %}

<div class="lr-stat-box {% if isSmall %}lr-stat-box-small{% endif %}{% if paletteName %} lr-stat-box-colored{% endif %} {{ extraClass }}"
     {% if boxStyle %}style="{{ boxStyle }}"{% endif %}>
    <div class="lr-stat-value"
         {% if valueId %}id="{{ valueId }}"{% endif %}
         {% if valueStyle %}style="{{ valueStyle }}"{% endif %}>
        {% if isValueFormatted %}
            {{ valuePrefix }}{{ value }}{{ valueSuffix }}
        {% else %}
            {{ valuePrefix }}{{ value|number_format }}{{ valueSuffix }}
        {% endif %}
    </div>
    <div class="lr-stat-label">{{ label }}</div>
</div>
