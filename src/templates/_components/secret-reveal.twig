{#
  Secret Reveal Component @since 5.25.0

  Displays a one-time secret (API key, OAuth token, signing key, etc.) in a
  read-only monospace input with a Copy button. The caller is expected to
  show this exactly once — there is no persistence or re-reveal behaviour
  in the component itself; that's the caller's responsibility (e.g. flash
  session storage, then render once on the redirect target).

  Used by:
  - Search Manager: API Keys edit page (post-creation reveal banner)

  Add new callers freely — this is a generic "show once, copy, never again"
  primitive. Any plugin generating credentials should reach for this.

  Usage (typical):
  {% include 'lindemannrock-base/_components/secret-reveal' with {
      secret: plaintextValue,
      title: 'Copy this key now — it will never be shown again.'|t('your-plugin'),
      helpText: 'We only store a hash. If you lose this value you will need to create a new credential.'|t('your-plugin'),
      type: 'success',
      margin: 'bottom',
  } only %}

  Parameters:
  - secret      (required, string) — the value to reveal + copy
  - title       (required, string) — bold heading shown above the input
  - helpText    (optional, string) — neutral paragraph shown below the input
  - type        (optional, string) — `info-box` type: 'success' (default), 'info', 'warning'
  - margin      (optional, string) — `info-box` margin: 'top', 'bottom' (default), 'both', 'none'

  Power-user knobs (rarely needed):
  - copyLabel   (string) — Copy button label. Defaults to 'Copy'|t('lindemannrock-base').
  - copiedLabel (string) — Post-click feedback label. Defaults to 'Copied!'|t('lindemannrock-base').
  - boxId       (string) — Unique id for JS targeting. Auto-generated when absent.

  Behaviour:
  - Click input → text selects (lets keyboard users Cmd/Ctrl+C as alternative)
  - Click Copy → navigator.clipboard.writeText, with execCommand('copy') fallback
  - Button label briefly becomes the `copiedLabel` and gains the `secondary` class
    for visual feedback (Craft's darker-gray button variant — distinct enough
    to register as "state changed" without the colour-loaded vibe of red/green)
  - JS is scoped per component instance via the unique boxId — multiple reveals on the same page coexist cleanly
  - No global namespace pollution; no shared function declarations

  @link      https://lindemannrock.com
  @copyright Copyright (c) 2026 LindemannRock
#}

{% set secret = secret ?? '' %}
{% set title = title ?? '' %}
{% set helpText = helpText ?? null %}
{% set type = type ?? 'success' %}
{% set margin = margin ?? 'bottom' %}
{% set boxId = boxId ?? ('lr-secret-' ~ random(999999999)) %}
{% set copyLabel = copyLabel ?? 'Copy'|t('lindemannrock-base') %}
{% set copiedLabel = copiedLabel ?? 'Copied!'|t('lindemannrock-base') %}

{% set messageHtml %}
    {% if title %}
        <strong>{{ title }}</strong>
    {% endif %}

    <div id="{{ boxId }}" style="display: flex; gap: 8px; margin: {{ title ? '0.75rem 0' : '0 0 0.75rem' }}; align-items: center;">
        <input type="text"
               readonly
               class="text fullwidth lr-secret-input"
               value="{{ secret|e('html_attr') }}"
               style="font-family: ui-monospace, 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace; cursor: copy; flex: 1;">
        <button type="button"
                class="btn lr-secret-copy-btn"
                data-original-label="{{ copyLabel|e('html_attr') }}"
                data-copied-label="{{ copiedLabel|e('html_attr') }}"
                style="white-space: nowrap;">{{ copyLabel }}</button>
    </div>

    {% if helpText %}
        <p class="light" style="margin: 0;">{{ helpText }}</p>
    {% endif %}
{% endset %}

{% include 'lindemannrock-base/_components/info-box' with {
    message: messageHtml,
    type: type,
    variant: 'colored',
    margin: margin,
    allowHtml: true,
} only %}

<script>
(function() {
    var box = document.getElementById({{ boxId|json_encode|raw }});
    if (!box) return;

    var input = box.querySelector('.lr-secret-input');
    var button = box.querySelector('.lr-secret-copy-btn');
    if (!input || !button) return;

    // Select-on-click affordance — matches password-field convention so
    // keyboard users can Cmd/Ctrl+C the value without using the button.
    input.addEventListener('click', function() {
        this.select();
    });

    button.addEventListener('click', function() {
        var value = input.value;
        var originalLabel = button.dataset.originalLabel;
        var copiedLabel = button.dataset.copiedLabel;

        function showCopiedFeedback() {
            button.textContent = copiedLabel;
            button.classList.add('secondary');
            setTimeout(function() {
                button.textContent = originalLabel;
                button.classList.remove('secondary');
            }, 2000);
        }

        function fallbackCopy() {
            input.select();
            try {
                document.execCommand('copy');
                showCopiedFeedback();
            } catch (_) {
                alert({{ 'Failed to copy to clipboard'|t('lindemannrock-base')|json_encode|raw }});
            }
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(value).then(showCopiedFeedback).catch(fallbackCopy);
        } else {
            fallbackCopy();
        }
    });
})();
</script>
