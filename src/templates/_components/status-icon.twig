{#
 # Status Icon Component
 #
 # Renders a standalone semantic status icon.
 #
 # Usage:
 # {% include 'lindemannrock-base/_components/status-icon' with {
 #     type: 'warning',
 # } only %}
 #
 # Inherit surrounding color:
 # {% include 'lindemannrock-base/_components/status-icon' with {
 #     type: 'success',
 #     colored: false,
 # } only %}
 #
 # Parameters:
 # - type: Icon type: info, success, warning, error
 # - colored: Apply the type color (default: true)
 # - class: Optional additional CSS classes
 # - title: Optional tooltip
 #
 # @since 5.34.0
 #}

{% set iconType = type ?? 'info' %}
{% if iconType not in ['info', 'success', 'warning', 'error'] %}
    {% set iconType = 'info' %}
{% endif %}

{% set iconClasses = [
    'lr-status-icon',
] %}
{% if colored ?? true %}
    {% set iconClasses = iconClasses|merge(['lr-status-icon--' ~ iconType]) %}
{% endif %}
{% if class ?? null %}
    {% set iconClasses = iconClasses|merge([class]) %}
{% endif %}

{% if iconType == 'success' %}
    <svg aria-hidden="true" class="{{ iconClasses|join(' ') }}"{% if title is defined and title %} title="{{ title }}"{% endif %} viewBox="0 0 16 16">
        <path fill="currentColor" d="M8 0C3.6 0 0 3.6 0 8s3.6 8 8 8 8-3.6 8-8-3.6-8-8-8zm3.7 6.3l-4 4c-.2.2-.4.3-.7.3s-.5-.1-.7-.3l-2-2c-.4-.4-.4-1 0-1.4s1-.4 1.4 0l1.3 1.3 3.3-3.3c.4-.4 1-.4 1.4 0s.4 1 0 1.4z"/>
    </svg>
{% elseif iconType == 'warning' %}
    <svg aria-hidden="true" class="{{ iconClasses|join(' ') }}"{% if title is defined and title %} title="{{ title }}"{% endif %} viewBox="0 0 16 16">
        <path fill="currentColor" d="M8 0C3.6 0 0 3.6 0 8s3.6 8 8 8 8-3.6 8-8-3.6-8-8-8zm1 12H7V7h2v5zm0-6H7V4h2v2z"/>
    </svg>
{% elseif iconType == 'error' %}
    <svg aria-hidden="true" class="{{ iconClasses|join(' ') }}"{% if title is defined and title %} title="{{ title }}"{% endif %} viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="7" fill="currentColor"/>
        <text x="8" y="12" text-anchor="middle" font-size="12" font-weight="bold" fill="white">!</text>
    </svg>
{% else %}
    <svg aria-hidden="true" class="{{ iconClasses|join(' ') }}"{% if title is defined and title %} title="{{ title }}"{% endif %} viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <text x="8" y="12" text-anchor="middle" font-size="11" font-weight="bold" fill="currentColor">i</text>
    </svg>
{% endif %}
