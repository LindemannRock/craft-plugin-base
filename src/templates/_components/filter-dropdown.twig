{#
 # Generic Dropdown Filter Component
 #
 # Renders a simple dropdown filter without status indicators.
 #
 # Parameters:
 # - filter: {
 #     param: 'language',
 #     current: 'all',
 #     label: 'All Languages',
 #     icon: 'language',  // Optional icon
 #     options: [
 #         {value: 'all', label: 'All Languages'},
 #         {value: 'en', label: 'English'},
 #         {value: 'ar', label: 'Arabic'},
 #     ]
 # }
 # - urlParams: Current URL parameters to maintain
 # - pageUrl: Canonical page URL for filter links
 #}

{% set pageUrl = pageUrl ?? '' %}
{% set querySeparator = '?' in pageUrl ? '&' : '?' %}
{% set currentOption = null %}
{% for option in filter.options ?? [] %}
    {% if option.value == filter.current %}
        {% set currentOption = option %}
    {% endif %}
{% endfor %}

<div class="btngroup">
    <button type="button" class="btn menubtn" title="{{ currentOption.label ?? filter.label ?? '' }}">
        {% if filter.icon ?? false %}
            <span class="icon" data-icon="{{ filter.icon }}"></span>
        {% endif %}
        {% if currentOption.shortLabel ?? false %}
            {{ currentOption.shortLabel }}
        {% else %}
            <span class="truncate" style="max-width: 200px; display: inline-block; vertical-align: bottom;">
                {{ currentOption.label ?? filter.label ?? 'All'|t('lindemannrock-base') }}
            </span>
            {% if currentOption.extra ?? false %}
                <span>{{ currentOption.extra }}</span>
            {% endif %}
        {% endif %}
    </button>
    <div class="menu" {% if filter.menuStyle ?? false %}style="{{ filter.menuStyle }}"{% endif %}>
        <ul>
            {% for option in filter.options ?? [] %}
                <li>
                    {% set optionParams = urlParams|merge({(filter.param): option.value, page: 1}) %}
                    <a class="{{ filter.current == option.value ? 'sel' : '' }}"
                       href="{{ pageUrl }}{{ querySeparator }}{{ optionParams|url_encode }}">
                        {{ option.label }}
                        {% if option.extra ?? false %}
                            <span>{{ option.extra }}</span>
                        {% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
