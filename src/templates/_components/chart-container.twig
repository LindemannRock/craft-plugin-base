{#
 # Chart Container Component
 #
 # Wrapper for chart elements with consistent styling.
 #
 # Parameters:
 #   - id: Canvas element ID (required for Chart.js)
 #   - title: (optional) Chart title
 #   - subtitle: (optional) Subtitle/description
 #   - fullWidth: (optional) Span full grid width
 #   - height: (optional) Canvas height utility: 200, 250, or 300
 #   - center: (optional) Center the chart canvas in the container
 #   - type: (optional) Chart.js type when data is provided
 #   - data: (optional) Chart.js data object
 #   - options: (optional) Chart.js options object
 #   - percentageTooltip: (optional) Add value + percentage tooltip labels
 #   - class: (optional) Additional CSS classes
 #
 # Example:
 #   {% include 'lindemannrock-base/_components/chart-container' with {
 #       id: 'daily-trend-chart',
 #       title: 'Daily Trend',
 #       fullWidth: true,
 #   } only %}
#}

{% do view.registerAssetBundle('lindemannrock\\base\\web\\assets\\components\\ComponentsAsset') %}

{% set chartId = id ?? '' %}
{% set chartTitle = title ?? '' %}
{% set chartSubtitle = subtitle ?? '' %}
{% set isFullWidth = fullWidth ?? false %}
{% set canvasHeight = (height ?? '')|replace({'px': ''}) %}
{% set isCentered = center ?? false %}
{% set extraClass = class ?? '' %}
{% set chartType = type ?? 'line' %}
{% set chartData = data ?? null %}
{% set chartOptions = options ?? {} %}
{% set usePercentageTooltip = percentageTooltip ?? false %}
{% set heightClasses = {
    '200': 'lr-chart-height-200',
    '250': 'lr-chart-height-250',
    '300': 'lr-chart-height-300',
} %}
{% set heightClass = heightClasses[canvasHeight] ?? '' %}
{% set chartConfig = chartData is not null ? {
    type: chartType,
    data: chartData,
    options: chartOptions,
    percentageTooltip: usePercentageTooltip,
} : null %}

{% if chartConfig %}
    {% do view.registerAssetBundle('lindemannrock\\base\\web\\assets\\analytics\\AnalyticsAsset') %}
{% endif %}

<div class="lr-chart-container {% if isFullWidth %}full-width{% endif %} {{ extraClass }}">
    {% if chartTitle %}
        <h3>{{ chartTitle }}</h3>
    {% endif %}

    {% if chartSubtitle %}
        <p class="light lr-chart-subtitle">{{ chartSubtitle }}</p>
    {% endif %}

    {% if chartId %}
        <div class="{% if heightClass %}{{ heightClass }}{% endif %}{% if isCentered %} lr-chart-center{% endif %}">
            <canvas
                id="{{ chartId }}"
                class="lr-chart-canvas"
                {% if chartConfig %}data-lr-chart-config="{{ chartConfig|json_encode|e('html_attr') }}"{% endif %}
            ></canvas>
        </div>
    {% endif %}

    {# Allow custom content inside #}
    {{ block('chartContent') ?? '' }}
</div>
