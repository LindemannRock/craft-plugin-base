{#
  Info Box Component

  Displays an informational notice with icon.

  Usage:
  {% include 'lindemannrock-base/_components/info-box' with {
      message: 'Your message here',
      type: 'info',        // 'info', 'success', 'warning', 'error'
      variant: 'subtle',   // 'subtle' (default - gray/white bg), 'colored' (colored bg based on type)
      margin: 'top',       // 'top' (default), 'bottom', 'both', 'none'
      bg: 'gray',          // 'gray' (default), 'white' - only applies when variant is 'subtle'
      stretch: false,      // true = full width with margin-inline: calc(var(--padding) * -1 + 2px)
      extraClass: null,    // optional additional class for scoped styling
      boxId: null,         // optional id for outer div (for JS targeting)
      messageId: null,     // optional id for message span (for JS text updates)
      hidden: false,       // true = starts with display: none (for JS-driven show/hide)
      allowHtml: true,     // default true for internal admin templates; set false for untrusted content
  } %}

  @link      https://lindemannrock.com
  @copyright Copyright (c) 2026 LindemannRock
#}

{% set iconType = type ?? 'info' %}
{% set variantStyle = variant ?? 'subtle' %}
{% set marginStyle = margin ?? 'top' %}
{% set bgStyle = bg ?? 'gray' %}

{% set boxClasses = [
    'lr-info-box',
    'lr-info-box--' ~ iconType,
    'lr-info-box--' ~ variantStyle,
    'lr-info-box--margin-' ~ marginStyle,
    'lr-info-box--bg-' ~ bgStyle,
] %}
{% if stretch ?? false %}
    {% set boxClasses = boxClasses|merge(['lr-info-box--stretch']) %}
{% endif %}
{% if extraClass ?? null %}
    {% set boxClasses = boxClasses|merge([extraClass]) %}
{% endif %}
{% if hidden ?? false %}
    {% set boxClasses = boxClasses|merge(['is-hidden']) %}
{% endif %}

<div{% if boxId is defined and boxId %} id="{{ boxId }}"{% endif %} class="{{ boxClasses|join(' ') }}">
    <div class="lr-info-box__inner">
        {% include 'lindemannrock-base/_components/status-icon' with {
            type: iconType,
            colored: false,
            class: 'lr-info-box__icon',
        } only %}
        <div{% if messageId is defined and messageId %} id="{{ messageId }}"{% endif %} class="lr-info-box__message">{{ (allowHtml ?? true) ? message|raw : message }}</div>
    </div>
</div>
