{#
 # Export Menu Component
 #
 # A reusable export dropdown menu that automatically shows only enabled formats.
 # Uses ExportHelper configuration from config/lindemannrock-base.php.
 # Supports plugin-specific overrides via pluginHandle parameter.
 # All exports are submitted via POST with CSRF tokens for security.
 #
 # Parameters:
 # - action: (required) The controller action URL (e.g., 'sms-manager/sms-logs/export')
 # - permission: (optional) Permission required to show export button
 # - pluginHandle: (optional) Plugin handle for config overrides (e.g., 'sms-manager')
 # - dateRangeParam: (optional) Current date range parameter name (default: 'dateRange')
 # - extraParams: (optional) Additional parameters to pass to export URL
 # - selectionAware: (optional) If true, shows count and passes selected IDs (default: false)
 # - idsParam: (optional) Parameter name for selected IDs (default: 'ids')
 # - id: (optional) Unique ID for this menu instance (auto-generated if not provided)
 #
 # Usage:
 #   {% include 'lindemannrock-base/_components/export-menu' with {
 #       action: 'sms-manager/sms-logs/export',
 #       permission: 'smsManager:downloadLogs',
 #       pluginHandle: 'sms-manager',
 #   } only %}
 #
 # Selection-aware (shows "Export (X)" when items selected):
 #   {% include 'lindemannrock-base/_components/export-menu' with {
 #       action: 'my-plugin/export',
 #       permission: 'myPlugin:export',
 #       pluginHandle: 'my-plugin',
 #       selectionAware: true,
 #   } only %}
 #
 # With extra params:
 #   {% include 'lindemannrock-base/_components/export-menu' with {
 #       action: 'my-plugin/export',
 #       permission: 'myPlugin:export',
 #       pluginHandle: 'my-plugin',
 #       extraParams: {status: statusFilter, provider: providerFilter},
 #   } only %}
 #}

{% set action = action ?? '' %}
{% set permission = permission ?? null %}
{% set pluginHandle = pluginHandle ?? null %}
{% set dateRangeParam = dateRangeParam ?? 'dateRange' %}
{% set extraParams = extraParams ?? {} %}
{% set selectionAware = selectionAware ?? false %}
{% set idsParam = idsParam ?? 'ids' %}
{% set menuId = id ?? 'lr-export-' ~ random() %}

{# Check permission if specified #}
{% set canExport = permission ? currentUser.can(permission) : true %}

{% if canExport and action %}
    {% set enabledFormats = lrExportFormats(pluginHandle) %}
    {% if enabledFormats|length > 0 %}
        {# Get current dateRange from request #}
        {% set currentDateRange = craft.app.request.getParam(dateRangeParam, lrDefaultDateRange(pluginHandle)) %}

        {# Build base params #}
        {% set baseParams = {(dateRangeParam): currentDateRange}|merge(extraParams) %}

        <div class="btngroup" id="{{ menuId }}">
            <button type="button" class="btn menubtn" data-icon="download">
                <span class="lr-export-label">{{ "Export"|t('app') }}</span>
            </button>
            <div class="menu" data-align="right">
                <ul>
                    {% if lrExportEnabled('excel', pluginHandle) %}
                        <li>
                            <a href="#" data-lr-export="{{ menuId }}" data-format="excel">{{ "Export as Excel"|t('app') }}</a>
                        </li>
                    {% endif %}
                    {% if lrExportEnabled('csv', pluginHandle) %}
                        <li>
                            <a href="#" data-lr-export="{{ menuId }}" data-format="csv">{{ "Export as CSV"|t('app') }}</a>
                        </li>
                    {% endif %}
                    {% if lrExportEnabled('json', pluginHandle) %}
                        <li>
                            <a href="#" data-lr-export="{{ menuId }}" data-format="json">{{ "Export as JSON"|t('app') }}</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>

        <script data-analytics-reinit>
        (function() {
            window._lrExportConfigs = window._lrExportConfigs || {};
            window._lrExportConfigs['{{ menuId }}'] = {
                actionUrl: '{{ actionUrl(action)|e('js') }}',
                csrfName: '{{ craft.app.config.general.csrfTokenName|e('js') }}',
                csrfValue: '{{ craft.app.request.csrfToken|e('js') }}',
                params: {{ baseParams|json_encode|raw }},
                {% if selectionAware %}
                selectedIds: [],
                idsParam: '{{ idsParam }}',
                {% endif %}
            };

            {% if selectionAware %}
            var menuEl = document.getElementById('{{ menuId }}');
            var label = menuEl ? menuEl.querySelector('.lr-export-label') : null;
            var defaultLabel = '{{ "Export"|t('app')|e('js') }}';
            var conf = window._lrExportConfigs['{{ menuId }}'];

            function updateExportLabel(ids) {
                conf.selectedIds = ids;
                if (label) {
                    var count = ids.length;
                    label.textContent = count > 0 ? defaultLabel + ' (' + count + ')' : defaultLabel;
                }
            }

            document.addEventListener('lr:selectionChanged', function(e) {
                updateExportLabel(e.detail.selectedIds || []);
            });

            if (window.lrTableSelection) {
                updateExportLabel(window.lrTableSelection.getSelectedIds());
            }
            {% endif %}

            if (!window._lrExportHandlerAttached) {
                window._lrExportHandlerAttached = true;
                document.addEventListener('click', function(e) {
                    var link = e.target.closest('[data-lr-export]');
                    if (!link) return;
                    e.preventDefault();

                    var id = link.dataset.lrExport;
                    var config = (window._lrExportConfigs || {})[id];
                    if (!config) return;

                    var format = link.dataset.format;
                    var form = document.createElement('form');
                    form.method = 'POST';
                    form.action = config.actionUrl;
                    form.style.display = 'none';

                    var csrf = document.createElement('input');
                    csrf.type = 'hidden';
                    csrf.name = config.csrfName;
                    csrf.value = config.csrfValue;
                    form.appendChild(csrf);

                    var params = Object.assign({}, config.params, {format: format});
                    if (config.selectedIds && config.selectedIds.length > 0) {
                        params[config.idsParam] = JSON.stringify(config.selectedIds);
                    }

                    for (var key in params) {
                        if (params[key] !== null && params[key] !== undefined) {
                            var input = document.createElement('input');
                            input.type = 'hidden';
                            input.name = key;
                            input.value = params[key];
                            form.appendChild(input);
                        }
                    }

                    document.body.appendChild(form);
                    form.submit();
                });
            }
        })();
        </script>
    {% endif %}
{% endif %}
